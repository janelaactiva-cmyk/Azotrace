# Configuração local. Copia para .env.local e preenche as chaves do teu projeto.
NEXT_PUBLIC_PRODUCT_NAME=Azotrace
NEXT_PUBLIC_SITE_TITLE=Azotrace
NEXT_PUBLIC_SITE_DESCRIPTION=Gestão da produção e rastreabilidade
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR="#47B37D"
NEXT_PUBLIC_THEME_COLOR_DARK="#0F172A"

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUBSTITUIR_PELA_CHAVE_ANON
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUIR_PELA_CHAVE_SERVICE_ROLE_DO_SERVIDOR

NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
NEXT_PUBLIC_DISPLAY_TERMS_AND_CONDITIONS_CHECKBOX=false

# Para compilar todas as rotas de pagamentos, mantém as chaves Stripe existentes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mantém os valores existentes dos serviços integrados da instalação original.
RESEND_API_KEY=
KEYINVOICE_API_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Para uma compilação/instalação de produção, NEXT_PUBLIC_SITE_URL deve usar
# o domínio HTTPS real da aplicação. O valor HTTP acima é para desenvolvimento.
# Nunca uses o prefixo NEXT_PUBLIC_ na chave service_role.
